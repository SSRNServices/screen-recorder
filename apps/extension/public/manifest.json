{
  "manifest_version": 3,
  "name": "ScreenRecorder",
  "version": "0.1.0",
  "description": "Production-quality screen recorder for Chromium browsers with native FFmpeg processing.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ScreenRecorder"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "downloads",
    "tabs",
    "desktopCapture",
    "tabCapture",
    "activeTab"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
